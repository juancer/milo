# Development / build / test image for the Go toolchain.
# Docker is a development dependency only; the Raspberry Pi runs the plain binary.
FROM golang:1.26@sha256:6c2a5538f964f1c82f97ad14988bf05de100d922d159d0e398b54c7b0ca0c6c9

# World-writable so the container can run as the host user and still use the
# named cache volumes (which inherit these permissions when first created).
RUN mkdir -p /cache /data && chmod 777 /cache /data

ENV GOCACHE=/cache/go-build \
    GOMODCACHE=/cache/go-mod \
    GOFLAGS=-buildvcs=false \
    CGO_ENABLED=0 \
    HOME=/tmp

WORKDIR /src
