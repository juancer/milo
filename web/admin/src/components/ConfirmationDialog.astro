---
import { t } from "../i18n";
import Button from "./Button.astro";
import Modal from "./Modal.astro";
---
<Modal id="confirm-dialog" titleId="confirm-title">
  <h2 id="confirm-title" data-i18n="confirm.title">{t("confirm.title")}</h2>
  <p id="confirm-message"></p>
  <div class="actions">
    <Button id="confirm-yes" variant="danger" labelKey="common.confirm" />
    <Button id="confirm-no" variant="secondary" labelKey="common.cancel" />
  </div>
</Modal>
