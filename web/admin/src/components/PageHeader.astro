---
import { t } from "../i18n";
interface Props {
  titleKey: string;
  descriptionKey?: string;
}
const { titleKey, descriptionKey } = Astro.props;
---
<header class="page-header">
  <h2 data-i18n={titleKey}>{t(titleKey)}</h2>
  {descriptionKey && <p class="muted" data-i18n={descriptionKey}>{t(descriptionKey)}</p>}
</header>
