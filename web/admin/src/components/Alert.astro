---
import { t } from "../i18n";
interface Props {
  id?: string;
  labelKey?: string;
  kind?: "error" | "info";
  hidden?: boolean;
}
const { id, labelKey, kind = "error", hidden } = Astro.props;
---
<p id={id} class:list={["alert", { error: kind === "error" }]} role={kind === "error" ? "alert" : "status"} hidden={hidden} data-i18n={labelKey}>{labelKey ? t(labelKey) : null}</p>
